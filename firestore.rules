rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User collection rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny broad collection scraping
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId) && incoming().id == existing().id;
      allow delete: if isOwner(userId);

      // User Applications Subcollection
      match /applications/{applicationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(applicationId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(applicationId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User Chat Messages Subcollection
      match /chats/{chatId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(chatId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // User Module Realtime Reports Subcollection
      match /reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reportId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(reportId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
